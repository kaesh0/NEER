# Sarvam AI API Key (powers language translation + LLM reasoning via sarvam-105b)
# Sign up at https://www.sarvam.ai to get your API key
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_CHAT_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_TRANSLATION_MODEL=mayura:v1
SARVAM_INPUT_TRANSLATION_MODE=modern-colloquial
SARVAM_OUTPUT_TRANSLATION_MODE=formal

# Marine data APIs (Open-Meteo is public and requires no key)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# MOSDAC (ISRO) Satellite Data API
# Register at https://www.mosdac.gov.in to obtain credentials
MOSDAC_USERNAME=your_mosdac_username_here
MOSDAC_PASSWORD=your_mosdac_password_here
MOSDAC_SST_DATASET_ID=3RIMG_L3B_SST_DLY
MOSDAC_CHLOROPHYLL_DATASET_ID=E06OCM_L4_AC
MOSDAC_SEARCH_DAYS=7
# Bounding box format: minLon,minLat,maxLon,maxLat (Default: South-West Indian Coast)
MOSDAC_BOUNDING_BOX=74.0,8.0,77.0,13.0
MOSDAC_DOWNLOAD_DIR=mosdac_data

# Official INCOIS PFZ landing page (Public bulletin, no key required)
INCOIS_PFZ_URL=https://www.incois.gov.in/MarineFisheries/TextDataHome?mfid=1&request_locale=en
